// Configuración de Cloudflare Workers para Stereo Barber Pool.
// Los HTML de la raíz se sirven como archivos estáticos y /api/* lo atiende worker/index.js.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceo-stereopoolbarber",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index", "/index.html", "/reservar", "/reservar.html", "/estado", "/estado.html", "/privacidad", "/privacidad.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "stereo-barber-db" }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "stereo-barber-fotos" }
  ],
  // Tiempo real: un Durable Object (con SQLite, disponible en el plan gratis) reparte los avisos por WebSocket.
  "durable_objects": { "bindings": [{ "name": "AVISOS", "class_name": "Avisos" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Avisos"] }],
  // Límites de Cloudflare (no tocan la base de datos). Periodo en segundos: 10 o 60.
  // RL_PUB: todo lo público por IP · RL_DNI: consultas de DNI · RL_RES: reservas, reprogramar y fichas.
  "ratelimits": [
    { "name": "RL_PUB", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_DNI", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_RES", "namespace_id": "4103", "simple": { "limit": 6, "period": 60 } }
  ],
  // Vence cada 5 minutos las reservas que no pagaron a tiempo.
  "triggers": { "crons": ["*/5 * * * *"] },
  // ID de cliente de Google (dato público). Va en el código para que no se pierda al desplegar.
  "vars": {
    "GOOGLE_CLIENT_ID": "186206646457-tu114jpn4uqdtpe2sb6v6l7g17shfq8b.apps.googleusercontent.com"
  },
  // OWNER_EMAILS (correos de los dueños), ALLOW_PIN y TURNSTILE_* se configuran en el panel de Cloudflare.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Entorno de desarrollo (staging): otro Worker con su propia base de datos y fotos, para probar antes de producción.
  // Se despliega con: npx wrangler deploy --env staging   (rama «desarrollo», ver CLAUDE.md)
  "env": {
    "staging": {
      "name": "ceo-stereopoolbarber-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "stereo-barber-db-staging" }
      ],
      "r2_buckets": [
        { "binding": "FOTOS", "bucket_name": "stereo-barber-fotos-staging" }
      ],
      "durable_objects": { "bindings": [{ "name": "AVISOS", "class_name": "Avisos" }] },
      "ratelimits": [
        { "name": "RL_PUB", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_DNI", "namespace_id": "4202", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RES", "namespace_id": "4203", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "186206646457-tu114jpn4uqdtpe2sb6v6l7g17shfq8b.apps.googleusercontent.com",
        "OWNER_EMAILS": "stereophysique15@gmail.com"
      }
    }
  }
}
